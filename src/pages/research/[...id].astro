---
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  getResearchEntries,
  formatDate,
  isoDate,
  researchTypeLabels,
} from '../../lib/content';
import { url } from '../../lib/url';

export const getStaticPaths: GetStaticPaths = async () => {
  const entries = await getResearchEntries();
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
};

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.abstract}>
  <article>
    <header class="entry-header">
      <p class="meta type-line">
        <span class="type">{researchTypeLabels[entry.data.type]}</span>
        {entry.data.venue && <span>{` · ${entry.data.venue}`}</span>}
        <span>
          {' · '}
          <time datetime={isoDate(entry.data.date)}>
            {formatDate(entry.data.date)}
          </time>
        </span>
      </p>

      <h1>{entry.data.title}</h1>

      {
        entry.data.authors.length > 0 && (
          <p class="meta authors">{entry.data.authors.join(', ')}</p>
        )
      }

      <p class="abstract"><strong>Abstract.</strong> {entry.data.abstract}</p>

      {
        entry.data.links.length > 0 && (
          <p class="links">
            {entry.data.links.map((link, i) => (
              <>
                {i > 0 && <span aria-hidden="true"> · </span>}
                <a href={link.href} rel="noopener">
                  {link.label}
                </a>
              </>
            ))}
          </p>
        )
      }
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>

  <p class="back">
    <a href={url('/research')}>← All research</a>
  </p>
</BaseLayout>

<style>
  .entry-header {
    max-width: var(--measure);
    margin-bottom: 3rem;
  }

  .type-line {
    margin-bottom: 0.5rem;
  }

  .type {
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.8em;
  }

  .authors {
    margin-top: 0.6rem;
    font-style: italic;
  }

  .abstract {
    margin-top: 1.25rem;
    padding-left: 1.25rem;
    border-left: 2px solid var(--color-accent-border);
    color: var(--color-text-muted);
  }

  .links {
    margin-top: 1.25rem;
    font-size: var(--text-sm);
  }

  .back {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-rule);
    max-width: var(--measure);
  }
</style>
